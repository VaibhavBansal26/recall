{
  "id": "recall-review-nudge",
  "name": "Recall: evening review nudge",
  "active": true,
  "nodes": [
    {
      "id": "every-evening",
      "name": "Every evening",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        120
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 18 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "run-now",
      "name": "Run now",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "parameters": {}
    },
    {
      "id": "get-stats",
      "name": "Get stats",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        200
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.RECALL_BACKEND_URL }}/api/stats",
        "options": {
          "timeout": 30000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Recall-Secret",
              "value": "={{ $env.RECALL_SHARED_SECRET }}"
            }
          ]
        }
      }
    },
    {
      "id": "too-many-waiting",
      "name": "Too many waiting",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c-c8caeb14",
              "leftValue": "={{ $json.due_now }}",
              "operator": {
                "type": "number",
                "operation": "gte"
              },
              "rightValue": "={{ Number($env.NUDGE_THRESHOLD || 10) }}"
            },
            {
              "id": "c-a0fa0d18",
              "leftValue": "={{ $env.NUDGE_URL || '' }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "send-nudge",
      "name": "Send nudge",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        120
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NUDGE_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Title",
              "value": "Recall"
            },
            {
              "name": "Tags",
              "value": "brain"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "text/plain",
        "body": "={{ $json.due_now }} reviews are waiting for you. A few minutes now keeps them fresh.",
        "options": {
          "timeout": 15000
        }
      }
    }
  ],
  "connections": {
    "Every evening": {
      "main": [
        [
          {
            "node": "Get stats",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run now": {
      "main": [
        [
          {
            "node": "Get stats",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get stats": {
      "main": [
        [
          {
            "node": "Too many waiting",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Too many waiting": {
      "main": [
        [
          {
            "node": "Send nudge",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
