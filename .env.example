# Copy to .env (make dev does this for you). Never commit .env.

# --- Postgres / ports ---
POSTGRES_USER=recall
POSTGRES_PASSWORD=recall
POSTGRES_DB=recall
POSTGRES_PORT=5433
BACKEND_PORT=8000
FRONTEND_PORT=3000
N8N_PORT=5678
TZ=UTC
# Your IANA time zone: decides what "today" means for the daily brief, stats, and the n8n schedules.
USER_TIMEZONE=UTC

# Used when running the backend on the host (make migrate / make test).
# Inside docker-compose this is overridden to point at the db container.
DATABASE_URL=postgresql+psycopg://recall:recall@localhost:5433/recall

# --- Voice ---
# fake = typed text only, canned audio (default, no keys needed)
# pipeline = browser mic -> speech-to-text -> LLM -> ElevenLabs voice.
# STT_PROVIDER=elevenlabs (default) needs only the ElevenLabs key; deepgram also needs DEEPGRAM_API_KEY.
VOICE_PROVIDER=fake
STT_PROVIDER=elevenlabs
STT_LANGUAGE=en
DEEPGRAM_API_KEY=
STT_MODEL=nova-3
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
TTS_MODEL=eleven_flash_v2_5
TTS_SPEED=1.0

# --- LLM (fake = deterministic stand-in, no key needed) ---
# anthropic needs ANTHROPIC_API_KEY plus both model names. Never hardcode models in code.
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
LLM_FAST_MODEL=claude-haiku-5-5
LLM_DEEP_MODEL=claude-sonnet-5-5

# --- Embeddings (fake = hashed bag-of-words; voyage = voyage-3, 1024 dims) ---
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=voyage-3
EMBEDDING_API_KEY=

# --- Capture ---
DEDUP_SIMILARITY=0.88
MAX_NOTES_PER_TURN=5

# --- Shared secret n8n sends to the backend (used from Phase 4) ---
RECALL_SHARED_SECRET=dev-shared-secret-change-me

# --- Evening review nudge (n8n). Leave NUDGE_URL empty to turn it off. ---
# An ntfy topic URL works well (https://ntfy.sh/pick-a-long-random-topic); only the count is sent.
NUDGE_URL=
NUDGE_THRESHOLD=10
