# Production settings for the cloud VM. Copy to `.env` on the VM and fill in. Never commit .env.

# --- Where it is served ---
# Your domain, with its DNS A record pointing at the VM. Caddy fetches the HTTPS certificate itself.
SITE_ADDRESS=recall.example.com
PUBLIC_ORIGIN=https://recall.example.com

# --- Login (single user) ---
# A long passphrase: 4+ random words or 16+ characters. At least 12 is enforced.
AUTH_PASSPHRASE=
# Signs the session cookie. Generate with:  openssl rand -hex 32
# Changing it logs every device out.
SESSION_SECRET=
COOKIE_SECURE=true

# --- Database (not exposed outside the VM) ---
POSTGRES_USER=recall
POSTGRES_DB=recall
POSTGRES_PASSWORD=   # openssl rand -hex 24

# --- Providers (fake = typed text only, no keys; see .env.example for all options) ---
VOICE_PROVIDER=fake
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
LLM_FAST_MODEL=claude-haiku-5-5
LLM_DEEP_MODEL=claude-sonnet-5-5
EMBEDDING_PROVIDER=fake
EMBEDDING_API_KEY=

# --- Only for n8n (Phase 4) ---
# Lets n8n call the ingest endpoints. Generate with:  openssl rand -hex 24
RECALL_SHARED_SECRET=
TZ=UTC
